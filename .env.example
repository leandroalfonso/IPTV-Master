# ============================================================
# StreamVault - configuração (NÃO versionar este arquivo com segredos reais)
# Copie para .env e edite com a sua lista.
# ============================================================

# Chave secreta do Flask (altere para algo único em produção).
SECRET_KEY=streamvault-dev-secret-change-me

# Tipo da fonte IPTV: "m3u" (padrão) ou "xtream" (futuro).
IPTV_TYPE=m3u

# URL da lista M3U (http/https) OU caminho de arquivo local.
# Exemplos:
#   IPTV_M3U_URL=https://exemplo.com/minha-lista.m3u
#   IPTV_M3U_URL=data/minha-lista.m3u
IPTV_M3U_URL=

# Credenciais Xtream Codes (apenas quando IPTV_TYPE=xtream).
IPTV_USERNAME=
IPTV_PASSWORD=

# Cache da lista em minutos.
IPTV_CACHE_MINUTES=30

# Tema padrão (dark).
THEME=dark

# Caminho do banco SQLite (comentado = usa o padrão data/streamvault.db).
# DATABASE_PATH=data/streamvault.db

# Host/porta (úteis em VPS).
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
